<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_vslam_bridge</name>
  <version>0.1.0</version>
  <description>Phase 3: TF (map-&gt;base_link from PX4 sim pose, static camera frames) for cuVSLAM verification, Phase 4 cuVSLAM-&gt;EKF2 external vision bridge, Phase 6 reactive ESDF avoidance.</description>

  <maintainer email="user@example.com">Drone Pilot</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>nvblox_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>python3-numpy</depend>
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <exec_depend>nvblox_ros</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
