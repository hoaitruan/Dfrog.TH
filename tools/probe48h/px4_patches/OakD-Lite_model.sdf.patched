<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='OakD-Lite'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0.00358 -0.03 .014 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000055421</iyy>
          <iyz>0</iyz>
          <izz>0.0000436519</izz>
        </inertia>
      </inertial>
      <visual name="OakD-Lite/visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://OakD-Lite/meshes/OakDLite.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="OakD-Lite/collision">
        <pose>0.00358 -0.03 .014 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0175 0.091 0.028</size>
          </box>
        </geometry>
      </collision>
      <sensor name="IMX214" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.01233 -0.03 .01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
      <sensor name="StereoOV7251" type="depth_camera">
        <!-- Distinct optical frame, not "camera_link" (FLU body link) --
             same bug/fix as StereoIMU's cameras: gz-sensors always renders
             in the standard optical convention (Z-forward,X-right,Y-down)
             regardless of the declared frame_id. nvblox uses TF
             (use_tf_transforms: true) to place depth points, so a
             body-frame-labeled depth image would misproject every point
             by the FLU->optical rotation.
             "_gt" (not plain camera_link_optical): rooted in PX4's own
             ground-truth TF chain (base_link_gt), not cuVSLAM's -- see
             the airframe file's EKF2_EV_CTRL=0 comment for why nvblox
             stopped trusting cuVSLAM's "odom" frame as of Phase 6. See
             px4_vslam_bridge/ground_truth_tf.py for the matching static
             TF (base_link_gt -> camera_link_gt -> camera_link_optical_gt). -->
        <gz_frame_id>camera_link_optical_gt</gz_frame_id>
        <pose>0.01233 -0.03 .01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>19.1</far>
          </clip>
          <!-- probe-48h H4 gate fix (docs/probe48h/GATE12.md A1): this
               sensor had NO noise at all, making a churn-from-sensor-noise
               effect structurally impossible to observe regardless of any
               other config. sdformat's camera <noise> element only
               supports a single, UNIFORM mean/stddev (checked against
               /usr/share/sdformat14/1.9/camera.sdf's own schema -- three
               sub-elements: type/mean/stddev, nothing range-dependent) --
               true stddev-grows-as-z^2 (approximating a RealSense D435i's
               real per-range accuracy curve) is NOT expressible in plain
               SDF and would need a custom sensor plugin, which is out of
               scope (algorithm-core territory) for this config-only fix.
               0.02m is the upper end of the "close range" 0.01-0.02m band
               given in the task -- a single representative value, not a
               range-accurate model; this simplification is disclosed, not
               hidden. See tools/probe48h/px4_patches/README.md. -->
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>depth_camera</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay />
    </link>
    <!-- <plugin filename="ignition-gazebo-sensors-system"
    name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin> -->
  </model>
</sdf>
